# Recito needs no environment variables and no API keys.
# Speech recognition (Whisper tiny.en) runs in the visitor's browser through Transformers.js,
# and the model files download from the public Hugging Face hub on first use.

# Adapter switch. "fake" (the default) reads fixtures/ so the whole flow works with no
# microphone and no model download; "real" runs in-browser Whisper.
ADAPTER_MODE=fake

# Set by next.config.ts from ADAPTER_MODE so client code can read it. Leave empty.
NEXT_PUBLIC_ADAPTER_MODE=

# Set by next.config.ts at build time from public/brand/*.png (read in lib/brand-files.ts). Leave empty.
NEXT_PUBLIC_BRAND_FILES=
